      "delivery_live \u00b7 ci: outside github; done when github.checks.completed with head_sha = the item's commit; success \u2192 review, failure \u2192 write; guard within 1800 s, then attention",
      "delivery_live \u00b7 review: outside github; done when github.pr.reviewed with state = setting review_state; done \u2192 sail; on github.pr.reviewed with state = \"changes_requested\" \u2192 write; guard within 1800 s, then attention",
      "delivery_live \u00b7 sail_check: outside github; done when github.pr.labeled with label = \"SAILED\"; done \u2192 close_ticket; on github.pr.labeled with label = \"REJECTED\" \u2192 triage; guard at most 3 rounds, then attention"
     ],
