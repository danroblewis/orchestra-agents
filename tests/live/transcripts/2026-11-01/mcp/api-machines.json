    "title": "Notes Improver",
    "description": "Watches tickets that land (DONE), tickets a reviewer rejects, and the merge gate; works out why tickets were rejected or failed the gate, and sends ideas to the Coordinator to schedule work that raises how many notes files get added per day.",
    "tags": [],
    "kind": "universal",
    "managed": "orchestra",
    "engagement": {
     "mode": "scheduled",
     "at": "00:00",
     "missed": "run once"
    },
